# ============================================
# InfraWatch Agent Dockerfile
# ============================================

FROM golang:1.24-alpine AS builder
RUN apk add --no-cache gcc musl-dev
WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o infrawatch-agent ./cmd/agent

FROM alpine:3.19
RUN apk add --no-cache ca-certificates tzdata su-exec

RUN addgroup -S infrawatch && adduser -S infrawatch -G infrawatch

WORKDIR /app

COPY --from=builder /build/infrawatch-agent .
COPY configs/agent.yaml ./configs/agent.yaml
COPY scripts/docker-entrypoint-agent.sh /usr/local/bin/docker-entrypoint.sh

RUN mkdir -p /etc/infrawatch/certs && \
    chown -R infrawatch:infrawatch /etc/infrawatch /app && \
    chmod +x /usr/local/bin/docker-entrypoint.sh

EXPOSE 0

ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["./infrawatch-agent", "--config", "configs/agent.yaml"]
